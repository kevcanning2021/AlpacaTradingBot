# crypto-paper-bot local config — safe to commit as-is, no real secrets.
# Copy this file to .env and edit values to experiment:
#   cp .env.example .env
# Every value is optional; unset values fall back to exactly what's shown.

# Binance symbol — public market-data endpoint, no API key required.
SYMBOL=BTCUSDT

# Candle interval Binance understands: 1m, 5m, 15m, 1h, 4h, 1d, ...
INTERVAL=5m

# EMA crossover lengths.
FAST_LENGTH=9
SLOW_LENGTH=21

# Simulated order size per trade, in units of the base asset (e.g. BTC).
QUANTITY=1

# Max concurrent positions — no pyramiding beyond this.
MAX_POSITION=1

# --- Optional WhatsApp alerts (scan command only) ----------------------
# Off by default. Reuses the same CallMeBot service/env var names as the
# Python bots' WhatsAppNotifier, so an existing CallMeBot registration
# works here too — no new signup needed. Only fires on a SKIP, or an
# approved BUY/SELL signal; never on a plain HOLD. Never places an order
# either way — this is a notification, not a trigger.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# --- Optional paper broker/MCP mode ------------------------------------
# No broker/MCP adapter exists in this repo yet. scan/replay:*/memory:*
# never place an order anywhere, paper or live — they only read public
# Binance market data and simulate. Wiring up a real paper-account
# connection (e.g. the Alpaca MCP server referenced in
# trading_bot_instructions.md) is a deliberate future step that needs its
# own reviewed adapter code, not just new env vars here. If/when that
# adapter exists, its setup will document its own required variables —
# never put real API keys in this file, and never in .env either unless
# you've confirmed .env is gitignored (it is, by default, in this repo).
